{
  "name": "vtex-io-intellisense",
  "displayName": "inmmerce for VTEX",
  "description": "Tema, snippets e IntelliSense para quem constrói na VTEX",
  "version": "3.0.0",
  "publisher": "commenteme",
  "license": "MIT",
  "icon": "images/icon.png",
  "main": "./extension.js",
  "scripts": {
    "test": "node --test",
    "icons:build": "node scripts/build-icon-theme.js",
    "icons:check": "node scripts/build-icon-theme.js && git diff --exit-code -- themes/ icons/"
  },
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:postcss",
    "onCommand:vtex-io-intellisense.generateTokensCss"
  ],
  "galleryBanner": {
    "color": "#1A181F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Snippets",
    "Themes",
    "Programming Languages"
  ],
  "keywords": [
    "vtex",
    "vtex io",
    "store framework",
    "storefront",
    "blocks",
    "snippets",
    "intellisense",
    "theme",
    "dark theme",
    "color theme",
    "icon theme",
    "product icon theme",
    "puelche"
  ],
  "homepage": "https://github.com/zeluizr/vtex-io-snippets#readme",
  "bugs": {
    "url": "https://github.com/zeluizr/vtex-io-snippets/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeluizr/vtex-io-snippets.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "vtex-io-intellisense.generateTokensCss",
        "title": "VTEX: Gerar tokens.css"
      }
    ],
    "configurationDefaults": {
      "[json]": {
        "editor.quickSuggestions": {
          "strings": true
        },
        "editor.suggest.snippetsPreventQuickSuggestions": false
      },
      "[jsonc]": {
        "editor.quickSuggestions": {
          "strings": true
        },
        "editor.suggest.snippetsPreventQuickSuggestions": false
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "blocks.json",
        "url": "./schemas/vtex-blocks.schema.json"
      },
      {
        "fileMatch": "blocks.jsonc",
        "url": "./schemas/vtex-blocks.schema.json"
      },
      {
        "fileMatch": "**/store/blocks/**/*.json",
        "url": "./schemas/vtex-blocks.schema.json"
      },
      {
        "fileMatch": "**/store/**/*.jsonc",
        "url": "./schemas/vtex-blocks.schema.json"
      },
      {
        "fileMatch": "**/store/*.jsonc",
        "url": "./schemas/vtex-blocks.schema.json"
      }
    ],
    "themes": [
      {
        "label": "Puelche",
        "uiTheme": "vs-dark",
        "path": "./themes/puelche-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "puelche-icons",
        "label": "Puelche",
        "path": "./themes/puelche-icon-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "gifenc": "^1.0.3",
    "sharp": "^0.35.0",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2woff": "^3.0.0"
  }
}
